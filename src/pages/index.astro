---
// Review hub: the three homepage concepts, nothing else.
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';

const concepts = [
  {
    href:   '/concept-a',
    tag:    'A',
    name:   'Command',
    body:   'Dark and product-led, with photography.',
    swatch: ['#09070e', '#9300fe', '#84bd00', '#ff8500'],
  },
  {
    href:   '/concept-b',
    tag:    'B',
    name:   'The Exercise',
    body:   'Light and editorial. One exercise, minute by minute.',
    swatch: ['#f7f7fb', '#7a45d6', '#8fe31a', '#ff8500'],
  },
  {
    href:   '/concept-c',
    tag:    'C',
    name:   'Live-Fire',
    body:   'Bold stencil type in yellow and cyan.',
    swatch: ['#09090b', '#ffd60a', '#0af3ff', '#ff4d3d'],
  },
];
---
<Base title="Cloud Range — Homepage Concepts" showBar={false}>
  <div class="hub">
    <header class="wrap top">
      <Logo />
    </header>

    <main class="wrap">
      <h1>Homepage concepts</h1>

      <ul class="cards">
        {concepts.map((c) => (
          <li>
            <a href={c.href} class="card">
              <div class="card-top">
                <span class="tag">{c.tag}</span>
                <div class="sw">{c.swatch.map((s) => <i style={`background:${s}`}></i>)}</div>
              </div>
              <h2>{c.name}</h2>
              <p>{c.body}</p>
              <span class="go">View concept →</span>
            </a>
          </li>
        ))}
      </ul>
    </main>
  </div>
</Base>

<style>
  .hub {
    --text:   #120f1a;
    --muted:  #5e5869;
    --line:   #e6e3ec;
    --purple: #9300fe;
    background: #fff;
    color: var(--text);
    font-family: 'Inter Variable', system-ui, sans-serif;
    min-height: 100vh;
    padding-bottom: 5rem;
    line-height: 1.6;
  }
  .wrap { width: min(1100px, 100% - 32px); margin-inline: auto; }
  a { text-decoration: none; color: inherit; }
  .top { padding: 2rem 0; }
  h1 { font-family: 'Space Grotesk Variable', sans-serif; font-size: clamp(2rem, 4vw, 3rem); font-weight: 600; letter-spacing: -0.03em; line-height: 1.1; margin: 3rem 0 2.5rem; }
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .card { display: flex; flex-direction: column; gap: 0.5rem; height: 100%; padding: 1.75rem; border: 1px solid var(--line); border-radius: 16px; transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s; }
  .card:hover { border-color: var(--purple); transform: translateY(-3px); box-shadow: 0 20px 40px -24px rgba(60, 20, 120, 0.3); }
  .card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; }
  .tag { width: 44px; height: 44px; display: grid; place-items: center; background: var(--purple); color: #fff; font-family: 'Saira Stencil One', sans-serif; font-size: 1.4rem; border-radius: 10px; }
  .sw { display: flex; }
  .sw i { width: 22px; height: 22px; border-radius: 50%; border: 2px solid #fff; margin-left: -6px; box-shadow: 0 0 0 1px var(--line); }
  h2 { font-family: 'Space Grotesk Variable', sans-serif; font-size: 1.75rem; font-weight: 600; letter-spacing: -0.02em; line-height: 1.15; }
  .card p { color: var(--muted); flex: 1; }
  .go { font-weight: 600; color: var(--purple); margin-top: 1rem; }
  @media (max-width: 860px) {
    .cards { grid-template-columns: 1fr; }
  }
</style>
