---
// Concept A — "Command"
// Dark, technical, product-forward. Positions Cloud Range alongside the
// SentinelOne / Cloudflare / Palo Alto tier: the hero *is* the product.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../data/icons';
import {
  hero, nav, products, stats, steps, industries,
  customers, quote, award, posts, footer, contact,
} from '../data/site';

import analystImg  from '../assets/photos/analyst-focus.jpg';
import exerciseImg from '../assets/photos/analyst-floor.jpg';
import floorImg    from '../assets/photos/eoc-floor.jpg';
import gridImg     from '../assets/photos/grid-control-room.jpg';
import cityImg     from '../assets/photos/city-eoc.jpg';
import labImg      from '../assets/photos/computer-lab.jpg';
import opsFloorImg from '../assets/photos/ops-floor.jpg';

// Color system: green = humans / defense / success, purple = AI / brand,
// orange = warnings and "contained", red = adversary.
const industryPhotos: Record<string, { src: ImageMetadata; alt: string }> = {
  'Commercial Enterprise':   { src: floorImg,    alt: 'Analysts working at monitors across an open office floor' },
  'Critical Infrastructure': { src: gridImg,     alt: 'Power plant control room with wall displays' },
  'Government & Military':   { src: cityImg,     alt: 'Two staff members talking in a city emergency operations center' },
  'Higher Education':        { src: labImg,      alt: 'Students working together in a university computer lab' },
  'MSSPs':                   { src: opsFloorImg, alt: 'Large operations floor with rows of workstations and wall displays' },
};

// Font Awesome Sharp Regular, same set as concept C.
const productIcons: Record<string, IconName> = {
  'platform':  'server',
  'live-fire': 'crosshairs',
  'ai':        'microchip-ai',
  'labs':      'flask',
  'tabletop':  'chess-knight',
};
const stepIcons: IconName[] = ['clone', 'bullseye-arrow', 'gauge-high', 'file-certificate'];
const industryIcons: Record<string, IconName> = {
  'Commercial Enterprise':   'building',
  'Critical Infrastructure': 'transformer-bolt',
  'Government & Military':   'landmark-flag',
  'Higher Education':        'graduation-cap',
  'MSSPs':                   'shield-halved',
};
const assumed   = ['Training completed', 'Tools deployed', 'AI tested in isolation', 'Annual tabletop'];
const validated = ['Performance under live attack', 'Detection proven in your stack', 'Agents scored on real decisions', 'Continuous, measured improvement'];

// Real customer logos (sliced from the live site's logo strips), shown in
// grayscale. Heights are tuned per logo so they read at the same visual weight.
const customerLogos = [
  { file: 'ibm',                  name: 'IBM',                  h: 28 },
  { file: 'aws',                  name: 'AWS',                  h: 34 },
  { file: 'hca-healthcare',       name: 'HCA Healthcare',       h: 34 },
  { file: 'anthropic',            name: 'Anthropic',            h: 16 },
  { file: 'bain',                 name: 'Bain & Company',       h: 32 },
  { file: 'ey',                   name: 'EY',                   h: 38 },
  { file: 'travelers',            name: 'Travelers',            h: 28 },
  { file: 'bluecross-blueshield', name: 'BlueCross BlueShield', h: 32 },
  { file: 'caci',                 name: 'CACI',                 h: 28 },
];

const trace = [
  { who: 'agent', step: 'Alert ingested',         detail: 'EDR · lsass.exe accessed by rundll32',  state: 'ok'   },
  { who: 'agent', step: 'Enriched & correlated',  detail: '3 related events on FIN-WS-114',        state: 'ok'   },
  { who: 'agent', step: 'Classified',             detail: 'T1003.001 credential dumping · 0.82',   state: 'ok'   },
  { who: 'agent', step: 'Proposed: isolate host', detail: 'Outside policy, escalated to human',    state: 'warn' },
  { who: 'human', step: 'Containment approved',   detail: 'Tier 2 analyst · 2m 14s after alert',   state: 'ok'   },
];

const aiPoints = [
  'Agents run the same live-fire scenarios as your analysts',
  'Every detection, decision, and escalation is scored',
  'Human-vs-agent benchmarks in the Performance Portal™',
];

const tactics = [
  { name: 'Initial access',    state: 't-done' },
  { name: 'Execution',         state: 't-done' },
  { name: 'Credential access', state: 't-live' },
  { name: 'Lateral movement',  state: 't-next' },
  { name: 'Impact',            state: 't-next' },
];

const timeline = [
  { t: '09:02:14', id: 'T1566.001', name: 'Spearphishing attachment', state: 'detected' },
  { t: '09:04:51', id: 'T1059.001', name: 'PowerShell execution',     state: 'detected' },
  { t: '09:11:07', id: 'T1003.001', name: 'LSASS memory dump',        state: 'missed'   },
  { t: '09:13:30', id: 'T1021.002', name: 'SMB lateral movement',     state: 'contained' },
];

const scores = [
  { who: 'Blue Team · Human', kind: 'human', score: 87, delta: '+12' },
  { who: 'SOC Agent · AI',    kind: 'ai',    score: 74, delta: '+5'  },
];

const bars = [62, 58, 51, 47, 40, 34, 29, 24, 21];
---
<Base title="Cloud Range — Concept A · Command">
  <div class="a">
    <header class="hdr">
      <div class="wrap hdr-in">
        <Logo tone="light" />
        <nav class="menu" aria-label="Primary">
          {nav.map((group) => (
            <div class="menu-item">
              <button type="button" aria-haspopup="true">{group.label}<span aria-hidden="true">▾</span></button>
              <ul class="drop">
                {group.items.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
              </ul>
            </div>
          ))}
        </nav>
        <div class="hdr-cta">
          <a href="#" class="link-quiet">Partner portal</a>
          <a href="#demo" class="btn btn-brand">Request a demo</a>
        </div>
        <details class="mnav">
          <summary aria-label="Open menu"><span></span><span></span></summary>
          <div class="mnav-panel">
            {nav.map((g) => (
              <div>
                <p class="mono">{g.label}</p>
                <ul>{g.items.map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul>
              </div>
            ))}
            <a href="#demo" class="btn btn-brand">Request a demo</a>
          </div>
        </details>
      </div>
    </header>

    <main>
      <!-- HERO -->
      <section class="hero">
        <div class="grid-bg" aria-hidden="true"></div>
        <div class="wrap hero-in">
          <div class="hero-copy">
            <a href="#award" class="pill">
              <span class="pill-dot"></span> Named {award.title} <span aria-hidden="true">→</span>
            </a>
            <h1>Validate the cyber readiness of <em class="h">humans</em> &amp; <em class="ai">AI agents</em>.</h1>
            <p class="lede">{hero.body}</p>
            <div class="hero-ctas">
              <a href="#demo" class="btn btn-purple btn-lg">Request a demo</a>
              <a href="#how" class="btn btn-ghost btn-lg">See how it works</a>
            </div>
            <ul class="hero-proof mono">
              <li>MITRE ATT&amp;CK aligned</li>
              <li>IT · OT/ICS · Cloud · Hybrid</li>
              <li>1,500+ scenarios</li>
            </ul>
          </div>

          <div class="hero-vis">
          <figure class="hero-photo duo duo-purple">
            <Image src={analystImg} alt="Analyst concentrating on a monitor during an exercise" widths={[600, 900, 1200]} sizes="(max-width: 1080px) 100vw, 640px" loading="eager" />
            <figcaption class="mono"><b></b>Blue team · exercise floor</figcaption>
          </figure>

          <!-- Product console mock -->
          <div class="console" role="img" aria-label="Example Cloud Range Performance Portal showing a live-fire exercise in progress">
            <div class="console-bar">
              <span class="dots"><i></i><i></i><i></i></span>
              <span class="mono">performance-portal / exercise-ransomware-0417</span>
              <span class="live mono"><b></b>LIVE</span>
            </div>
            <div class="console-body">
              <div class="panel scores">
                {scores.map((s) => (
                  <div class="score">
                    <p class="mono label">{s.who}</p>
                    <p class="num">{s.score}<small>/100</small></p>
                    <div class:list={['meter', s.kind]}><span style={`width:${s.score}%`}></span></div>
                    <p class="mono delta">{s.delta} vs. last exercise</p>
                  </div>
                ))}
              </div>
              <div class="panel chart">
                <p class="mono label">Mean time to detect · min</p>
                <div class="bars">
                  {bars.map((h, i) => <span style={`height:${h * 1.4}%`} class:list={[i === bars.length - 1 && 'now']}></span>)}
                </div>
                <p class="mono chart-foot"><span>Q1</span><span class="up">↓ 66%</span><span>Q3</span></p>
              </div>
              <div class="panel feed">
                <p class="mono label">Attack timeline</p>
                <ul>
                  {timeline.map((e) => (
                    <li>
                      <span class="mono t">{e.t}</span>
                      <span class="mono id">{e.id}</span>
                      <span class="nm">{e.name}</span>
                      <span class:list={['mono', 'st', e.state]}>{e.state}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
          </div>
        </div>
      </section>

      <!-- LOGOS -->
      <section class="logos" aria-label="Customers">
        <div class="wrap">
          <p class="mono center muted">The world's most advanced SOCs depend on Cloud Range</p>
          <ul class="logo-row">
            {customerLogos.map((l) => <li><img src={`/logos/${l.file}.png`} alt={l.name} style={`height:${l.h}px`} loading="lazy" decoding="async" /></li>)}
          </ul>
        </div>
      </section>

      <!-- EXERCISE FLOOR -->
      <section class="floor" aria-labelledby="floor-h">
        <div class="floor-img duo duo-purple">
          <Image src={exerciseImg} alt="Operations floor with staff working an incident at their workstations" widths={[800, 1400, 2000]} sizes="100vw" />
        </div>
        <div class="wrap floor-in">
          <div class="floor-copy">
            <p class="eyebrow mono">// Live-fire</p>
            <h2 id="floor-h">Nothing prepares defenders like the real thing.</h2>
            <p>Real attackers, real tools, real pressure, in a range built to mirror your environment. Your team gets the experience of a breach before it happens to you.</p>
          </div>
          <ul class="chips" aria-label="Example live exercise events">
            <li class="chip red"><span class="mono">09:11:07 · Adversary</span>LSASS memory dump on FIN-WS-114</li>
            <li class="chip purple"><span class="mono">09:11:19 · SOC agent</span>Flagged credential dumping · 0.82</li>
            <li class="chip green"><span class="mono">09:13:21 · Blue team</span>Host contained, lateral movement stopped</li>
          </ul>
        </div>
      </section>

      <!-- PROBLEM -->
      <section class="sec light">
        <div class="wrap split">
          <div>
            <p class="eyebrow mono">// The readiness gap</p>
            <h2>Move beyond assumed readiness.</h2>
          </div>
          <div class="contrast">
            <div class="col old">
              <p class="mono label">Assumed</p>
              <ul>{assumed.map((t) => <li><Icon name="circle-xmark" class="li-ic" />{t}</li>)}</ul>
            </div>
            <div class="col new">
              <p class="mono label">Validated</p>
              <ul>{validated.map((t) => <li><Icon name="circle-check" class="li-ic" />{t}</li>)}</ul>
            </div>
          </div>
        </div>
      </section>

      <!-- PLATFORM BENTO -->
      <section class="sec" id="platform">
        <div class="wrap">
          <div class="sec-head">
            <p class="eyebrow mono">// Platform</p>
            <h2>One range. Every way your defense gets tested.</h2>
            <p class="muted">The leading cyber range platform for human readiness and AI validation — fully managed, built on your environment.</p>
          </div>
          <div class="bento">
            {products.map((p, i) => (
              <a href="#" class:list={['card', `card-${i}`]}>
                <div class="card-vis" aria-hidden="true">
                  {p.key === 'platform' && (
                    <svg viewBox="0 0 320 120" class="mini-topo">
                      <path d="M40 60 H110 M110 60 L180 25 M110 60 L180 95 M180 25 H260 M180 95 H260 M260 25 V95" />
                      <rect x="16" y="46" width="48" height="28" rx="6" class="n" /><text x="40" y="64">FW</text>
                      <rect x="86" y="46" width="48" height="28" rx="6" class="n" /><text x="110" y="64">AD</text>
                      <rect x="156" y="11" width="48" height="28" rx="6" class="n" /><text x="180" y="29">EDR</text>
                      <rect x="156" y="81" width="48" height="28" rx="6" class="n" /><text x="180" y="99">OT</text>
                      <rect x="236" y="11" width="48" height="28" rx="6" class="n g" /><text x="260" y="29">SIEM</text>
                      <rect x="236" y="81" width="48" height="28" rx="6" class="n p" /><text x="260" y="99">AI</text>
                    </svg>
                  )}
                  {p.key === 'live-fire' && (
                    <ol class="mini-chain">
                      {tactics.map((t) => <li class={t.state}>{t.name}</li>)}
                    </ol>
                  )}
                  {p.key === 'ai' && (
                    <div class="mini-vs">
                      <p><span>Human</span><i class="h" style="--w:87%"></i><b>87</b></p>
                      <p><span>Agent</span><i class="ai" style="--w:74%"></i><b>74</b></p>
                    </div>
                  )}
                  {p.key === 'labs' && (
                    <div class="mini-grid">
                      {Array.from({ length: 28 }, (_, k) => <i class:list={[k % 7 < 5 - Math.floor(k / 7) % 3 && 'on', k === 17 && 'now']}></i>)}
                    </div>
                  )}
                  {p.key === 'tabletop' && (
                    <div class="mini-decide">
                      <p class="mono">Decision 3 of 7 · 09:52</p>
                      <p class="q">Notify regulators now?</p>
                      <p class="opts"><span class="pick">Yes, within 1 hr</span><span>Wait for forensics</span></p>
                    </div>
                  )}
                </div>
                <p class="card-meta"><span class="card-ic"><Icon name={productIcons[p.key]} /></span><span class="mono card-n">0{i + 1}</span></p>
                <h3>{p.name}</h3>
                <p class="card-tag">{p.tagline}</p>
                <p class="muted">{p.body}</p>
                <span class="card-go mono">Explore →</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- AI -->
      <section class="sec ai-sec" id="ai">
        <div class="wrap split">
          <div>
            <p class="eyebrow mono">// AI Validation Range™</p>
            <h2>Your SOC agents are about to make decisions. Test them first.</h2>
            <p class="muted">Agentic AI is moving into detection and response faster than anyone can audit it. Cloud Range puts agents in the same live-fire scenarios as your analysts, then scores behavior, escalation, and outcome side by side.</p>
            <ul class="checks">
              {aiPoints.map((c) => <li>{c}</li>)}
            </ul>
            <a href="#demo" class="btn btn-ghost">Explore AI validation</a>
          </div>
          <div class="trace" role="img" aria-label="Example decision trace: a SOC agent detects and classifies credential dumping, escalates, and a human analyst approves containment">
            <div class="trace-head">
              <p class="mono">Decision trace · exercise-0417</p>
              <p class="mono legend"><span class="h">Human</span><span class="ai">Agent</span></p>
            </div>
            <ol>
              {trace.map((t, i) => (
                <li class:list={[t.who, t.state]}>
                  <span class="dot"></span>
                  <div>
                    <p class="tr-step">{t.step}</p>
                    <p class="mono tr-detail">{t.detail}</p>
                  </div>
                  <span class="mono tm">+{[0, 4, 12, 31, 134][i]}s</span>
                </li>
              ))}
            </ol>
            <div class="trace-foot">
              <div><p class="mono">Agent score</p><p class="v ai">74</p></div>
              <div><p class="mono">Human score</p><p class="v h">87</p></div>
              <div><p class="mono">Outcome</p><p class="v ok">Contained</p></div>
            </div>
          </div>
        </div>
      </section>

      <!-- HOW -->
      <section class="sec light" id="how">
        <div class="wrap">
          <div class="sec-head">
            <p class="eyebrow mono">// How it works</p>
            <h2>Real experience, before the real incident.</h2>
          </div>
          <ol class="steps">
            {steps.map((s, i) => (
              <li>
                <div class="step-top">
                  <p class="mono step-n">{s.n}</p>
                  <Icon name={stepIcons[i]} size="1.6rem" class="step-ic" />
                </div>
                <h3>{s.title}</h3>
                <p class="muted">{s.body}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- STATS -->
      <section class="stats" aria-label="Quantifiable impact">
        <div class="wrap stats-in">
          {stats.map((s) => (
            <div>
              <p class="stat">{s.value}<span>{s.unit}</span></p>
              <p class="muted">{s.label}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- INDUSTRIES -->
      <section class="sec" id="industries">
        <div class="wrap">
          <div class="sec-head">
            <p class="eyebrow mono">// Industries</p>
            <h2>Built for the teams that can't afford a first time.</h2>
          </div>
          <ul class="ind">
            {industries.map((i) => (
              <li>
                <a href="#">
                  <div class="ind-img duo">
                    <Image src={industryPhotos[i.name].src} alt={industryPhotos[i.name].alt} widths={[400, 700]} sizes="(max-width: 640px) 100vw, (max-width: 1080px) 33vw, 240px" />
                  </div>
                  <div class="ind-body">
                    <div class="ind-ic"><Icon name={industryIcons[i.name]} /></div>
                    <h3>{i.name}</h3>
                    <p class="muted">{i.body}</p>
                  </div>
                  <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- PROOF -->
      <section class="sec light proof-sec" id="award">
        <div class="wrap proof">
          <figure class="quote">
            <blockquote>“{quote.text}”</blockquote>
            <figcaption class="mono">— {quote.source}</figcaption>
          </figure>
          <div class="award">
            <Icon name="trophy-star" size="2.25rem" class="award-ic" />
            <p class="mono label">Award</p>
            <p class="award-t">{award.title}</p>
            <p class="muted">{award.body}</p>
          </div>
        </div>
      </section>

      <!-- RESOURCES -->
      <section class="sec light posts-sec" id="resources">
        <div class="wrap">
          <div class="sec-head row">
            <div>
              <p class="eyebrow mono">// Intel</p>
              <h2>Latest from Cloud Range</h2>
            </div>
            <a href="#" class="link-quiet">All articles →</a>
          </div>
          <ul class="posts">
            {posts.map((p) => (
              <li>
                <a href="#">
                  <p class="mono muted">{p.tag} · {p.date}</p>
                  <h3>{p.title}</h3>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- CTA -->
      <section class="cta" id="demo">
        <div class="wrap cta-in">
          <h2>Feel confident about your cyber defense.</h2>
          <p class="muted">See a live-fire exercise in your own environment. 30 minutes, no slides.</p>
          <div class="hero-ctas">
            <a href="#" class="btn btn-brand btn-lg">Request a demo</a>
            <a href={`tel:${contact.phone.replaceAll('.', '')}`} class="btn btn-ghost btn-lg">{contact.phone}</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="ftr">
      <div class="wrap ftr-in">
        <div class="ftr-brand">
          <Logo tone="light" />
          <p class="muted">Validate cyber readiness of humans &amp; AI agents.</p>
          <p class="muted"><a href={`mailto:${contact.email}`}>{contact.email}</a><br />{contact.phone}</p>
        </div>
        {footer.map((col) => (
          <div>
            <p class="mono label">{col.title}</p>
            <ul>{col.links.map((l) => <li><a href="#">{l}</a></li>)}</ul>
          </div>
        ))}
      </div>
      <div class="wrap ftr-legal mono muted">
        <span>© 2026 Cloud Range</span>
        <a href="#">Privacy policy</a>
      </div>
    </footer>
  </div>
</Base>

<style>
  .a {
    --bg:       #070a08;
    --bg-2:     #0e120f;
    --panel:    #131814;
    --line:     rgba(255, 255, 255, 0.08);
    --line-2:   rgba(255, 255, 255, 0.14);
    --text:     #eff3ef;
    --muted:    #97a39b;
    --green:    #84bd00;
    --green-ink: #0b1402;
    --purple:   #9300fe;
    --purple-2: #a733ff;
    --purple-t: #c08bff;
    --lime:     #9ad62a;
    --lime-2:   #b4ec4a;
    --red:      #ff5d5d;
    --amber:    #ff8500;
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter Variable', system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.6;
    min-height: 100vh;
  }
  .wrap { width: min(1240px, 100% - 32px); margin-inline: auto; }
  .mono { font-family: 'JetBrains Mono Variable', ui-monospace, monospace; font-size: 0.78rem; letter-spacing: 0.02em; }
  .muted { color: var(--muted); }
  .center { text-align: center; }
  .label { color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.7rem; }
  h1, h2, h3 { font-family: 'Space Grotesk Variable', 'Inter Variable', sans-serif; font-weight: 600; letter-spacing: -0.02em; line-height: 1.08; }
  h2 { font-size: clamp(2rem, 4vw, 3.1rem); }
  h3 { font-size: 1.2rem; letter-spacing: -0.01em; }
  a { text-decoration: none; }

  /* Buttons */
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; font-weight: 600; font-size: 0.92rem; padding: 0.7rem 1.1rem; border-radius: 8px; transition: background 0.2s, border-color 0.2s, transform 0.2s; white-space: nowrap; }
  .btn-lg { padding: 0.95rem 1.4rem; font-size: 1rem; }
  .btn-brand { background: var(--green); color: var(--green-ink); box-shadow: 0 8px 24px -8px rgba(132, 189, 0, 0.6); }
  .btn-brand:hover { background: var(--lime); }
  .btn-purple { background: var(--purple); color: #fff; box-shadow: 0 8px 24px -8px rgba(147, 0, 254, 0.7); }
  .btn-purple:hover { background: var(--purple-2); }
  .btn-ghost { border: 1px solid var(--line-2); color: var(--text); }
  .btn-ghost:hover { border-color: var(--lime); }
  .link-quiet { color: var(--muted); font-size: 0.9rem; }
  .link-quiet:hover { color: var(--text); }

  /* Header */
  .hdr { position: sticky; top: 0; z-index: 50; background: rgba(7, 10, 8, 0.8); backdrop-filter: blur(14px); border-bottom: 1px solid var(--line); }
  .hdr-in { display: flex; align-items: center; gap: 2rem; height: 68px; }
  .menu { display: flex; gap: 0.25rem; margin-right: auto; }
  .menu-item { position: relative; }
  .menu-item > button { background: none; border: 0; color: var(--text); padding: 0.5rem 0.75rem; font-size: 0.92rem; display: flex; gap: 0.35rem; align-items: center; cursor: pointer; border-radius: 6px; }
  .menu-item > button span { font-size: 0.6rem; color: var(--muted); }
  .menu-item:hover > button, .menu-item:focus-within > button { background: rgba(255, 255, 255, 0.05); }
  .drop { position: absolute; top: calc(100% + 8px); left: 0; min-width: 260px; padding: 0.5rem; background: var(--panel); border: 1px solid var(--line-2); border-radius: 12px; box-shadow: 0 24px 48px rgba(0, 0, 0, 0.5); opacity: 0; visibility: hidden; transform: translateY(-4px); transition: 0.18s; }
  .drop::before { content: ''; position: absolute; inset: -10px 0 auto; height: 10px; }
  .menu-item:hover .drop, .menu-item:focus-within .drop { opacity: 1; visibility: visible; transform: none; }
  .drop a { display: block; padding: 0.55rem 0.75rem; border-radius: 8px; font-size: 0.9rem; color: var(--text); }
  .drop a:hover { background: rgba(132, 189, 0, 0.12); color: var(--lime-2); }
  .hdr-cta { display: flex; gap: 1.25rem; align-items: center; }
  .mnav { display: none; }

  /* Hero */
  .hero { position: relative; overflow: hidden; padding: 5.5rem 0 6rem; border-bottom: 1px solid var(--line); }
  .grid-bg { position: absolute; inset: 0; background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(ellipse 80% 70% at 70% 30%, #000 20%, transparent 75%); }
  .hero::after { content: ''; position: absolute; width: 720px; height: 720px; right: -120px; top: -200px; background: radial-gradient(closest-side, rgba(132, 189, 0, 0.42), transparent); pointer-events: none; }
  .hero-in { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr 1.15fr; gap: 3.5rem; align-items: center; }
  .pill { display: inline-flex; align-items: center; gap: 0.55rem; font-size: 0.82rem; padding: 0.4rem 0.85rem; border: 1px solid var(--line-2); border-radius: 999px; color: var(--muted); margin-bottom: 1.75rem; }
  .pill:hover { color: var(--text); border-color: var(--lime); }
  .pill-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--lime); box-shadow: 0 0 10px var(--lime); }
  h1 { font-size: clamp(2.6rem, 5.4vw, 4.4rem); }
  h1 em { font-style: normal; }
  h1 em.h, h1 em.ai { color: var(--green); }
  .lede { font-size: 1.12rem; color: var(--muted); margin: 1.5rem 0 2.25rem; max-width: 34rem; }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .hero-proof { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin-top: 2.5rem; color: var(--muted); }
  .hero-proof li::before { content: '■ '; color: var(--lime); font-size: 0.6rem; vertical-align: 2px; }

  /* Console */
  .console { background: linear-gradient(180deg, #141a15, #0b0f0c); border: 1px solid var(--line-2); border-radius: 14px; box-shadow: 0 40px 80px -20px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(132, 189, 0, 0.18), 0 0 80px -20px rgba(132, 189, 0, 0.35); overflow: hidden; }
  .console-bar { display: flex; align-items: center; gap: 1rem; padding: 0.75rem 1rem; border-bottom: 1px solid var(--line); color: var(--muted); }
  .console-bar .mono { min-width: 0; font-size: 0.7rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dots { display: flex; gap: 6px; }
  .dots i { width: 10px; height: 10px; border-radius: 50%; background: #252c27; }
  .live { margin-left: auto; color: var(--red); display: flex; align-items: center; gap: 6px; }
  .live b { width: 7px; height: 7px; border-radius: 50%; background: var(--red); animation: pulse 1.4s infinite; }
  @keyframes pulse { 50% { opacity: 0.25; } }
  .console-body { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--line); }
  .panel { background: #0c100d; padding: 1.1rem 1.2rem; }
  .scores { display: grid; gap: 1.1rem; }
  .num { font-family: 'Space Grotesk Variable', sans-serif; font-size: 2rem; font-weight: 600; line-height: 1.1; margin-top: 0.25rem; }
  .num small { font-size: 0.85rem; color: var(--muted); font-weight: 400; }
  .meter { height: 5px; background: #1d241f; border-radius: 3px; margin: 0.5rem 0 0.4rem; overflow: hidden; }
  .meter span { display: block; height: 100%; background: linear-gradient(90deg, var(--lime), var(--lime-2)); }
  .meter.ai span { background: linear-gradient(90deg, var(--purple), var(--purple-t)); }
  .delta { color: var(--lime); font-size: 0.68rem; }
  .bars { display: flex; align-items: flex-end; gap: 6px; height: 120px; margin: 1rem 0 0.5rem; }
  .bars span { flex: 1; background: #22302a; border-radius: 3px 3px 0 0; }
  .bars span.now { background: var(--lime); box-shadow: 0 0 16px rgba(154, 214, 42, 0.5); }
  .chart-foot { display: flex; justify-content: space-between; color: var(--muted); font-size: 0.66rem; }
  .chart-foot .up { color: var(--lime); }
  .feed { grid-column: 1 / -1; }
  .feed ul { margin-top: 0.6rem; display: grid; gap: 1px; }
  .feed li { display: grid; grid-template-columns: 70px 82px 1fr auto; gap: 0.75rem; align-items: center; padding: 0.55rem 0; border-top: 1px solid var(--line); font-size: 0.85rem; }
  .feed .t, .feed .id { font-size: 0.68rem; color: var(--muted); }
  .feed .id { color: var(--purple-t); }
  .st { font-size: 0.64rem; text-transform: uppercase; padding: 0.2rem 0.5rem; border-radius: 4px; }
  .st.detected { color: var(--lime); background: rgba(140, 198, 63, 0.12); }
  .st.missed { color: var(--red); background: rgba(255, 93, 93, 0.12); }
  .st.contained { color: var(--amber); background: rgba(255, 133, 0, 0.14); }

  /* Logos */
  .logos { padding: 3rem 0; background: #fff; border-bottom: 1px solid #e0e6dc; }
  .logos .muted { color: #56625a; }
  .logo-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1.75rem 2.25rem; margin-top: 1.75rem; }
  .logo-row li { display: flex; align-items: center; }
  .logo-row img { width: auto; max-width: 180px; filter: grayscale(1) contrast(1.1); opacity: 0.62; transition: filter 0.2s, opacity 0.2s; }
  .logo-row li:hover img { filter: none; opacity: 1; }

  /* Sections */
  .sec { padding: 7rem 0; border-bottom: 1px solid var(--line); }

  /* Light sections: same components, tokens swapped. Green shifts darker so it
     still reads as "humans / defense" with text-level contrast on white. */
  .light {
    --bg:       #f4f6f2;
    --bg-2:     #ffffff;
    --panel:    #ffffff;
    --line:     #e0e6dc;
    --line-2:   #d0d9cb;
    --text:     #0f1410;
    --muted:    #56625a;
    --lime:     #4c8a00;
    --purple-t: #7a1fd6;
    background: var(--bg);
    color: var(--text);
    border-bottom-color: var(--line);
  }
  .light .new { background: linear-gradient(160deg, rgba(132, 189, 0, 0.14), #fff 70%); }
  .light .old li { text-decoration-color: rgba(214, 48, 48, 0.55); }
  .light .steps li::before { background: #84bd00; }
  .light .steps li { background: #fff; }
  .light .steps { box-shadow: 0 20px 40px -28px rgba(15, 35, 10, 0.2); }
  .light .quote { box-shadow: 0 20px 40px -28px rgba(15, 35, 10, 0.25); }
  .light .award { background: linear-gradient(160deg, rgba(255, 133, 0, 0.14), #fff 70%); border-color: rgba(255, 133, 0, 0.5); }
  .light .award .label { color: #a34f00; }
  .light .posts a:hover { border-color: var(--lime); }
  .proof-sec { padding-bottom: 3rem; border-bottom: 0; }
  .posts-sec { padding-top: 3rem; }
  .sec-head { max-width: 46rem; margin-bottom: 3.5rem; }
  .sec-head.row { max-width: none; display: flex; justify-content: space-between; align-items: end; gap: 2rem; }
  .sec-head p.muted { font-size: 1.1rem; margin-top: 1rem; }
  .eyebrow { color: var(--lime); margin-bottom: 1rem; font-size: 0.82rem; }
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; }
  .split > div > p.muted { margin: 1.25rem 0 2rem; font-size: 1.08rem; }

  .contrast { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid var(--line-2); border-radius: 14px; overflow: hidden; }
  .contrast .col { padding: 1.75rem; }
  .contrast ul { display: grid; gap: 0.9rem; margin-top: 1rem; }
  .old { background: var(--bg-2); }
  .old li { color: var(--muted); text-decoration: line-through; text-decoration-color: rgba(255, 93, 93, 0.6); }
  .contrast li { display: flex; gap: 0.65rem; align-items: baseline; }
  .contrast :global(.li-ic) { flex-shrink: 0; position: relative; top: 0.1em; }
  .old :global(.li-ic) { color: #e0605a; }
  .new :global(.li-ic) { color: var(--lime); }
  .new { background: linear-gradient(160deg, rgba(143, 204, 10, 0.12), transparent 70%); border-left: 1px solid var(--line-2); }
  .new .label { color: var(--lime); }

  .bento { display: grid; grid-template-columns: repeat(6, 1fr); gap: 1rem; }
  .card { position: relative; display: flex; flex-direction: column; gap: 0.6rem; padding: 1.75rem; background: var(--bg-2); border: 1px solid var(--line); border-radius: 14px; color: var(--text); transition: border-color 0.2s, transform 0.2s; grid-column: span 2; min-height: 260px; }
  .card:hover { border-color: rgba(154, 214, 42, 0.55); transform: translateY(-2px); }
  .card-0, .card-1 { grid-column: span 3; }
  .card-0 { background: radial-gradient(120% 120% at 100% 0%, rgba(132, 189, 0, 0.22), transparent 55%), var(--bg-2); }
  .card-n { color: var(--muted); }
  .card-meta { display: flex; justify-content: space-between; align-items: center; }
  .card-ic { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; font-size: 1.2rem; color: var(--lime); background: rgba(132, 189, 0, 0.1); border: 1px solid rgba(154, 214, 42, 0.35); }
  .card:hover .card-ic { color: var(--green-ink); background: var(--lime); }
  .card h3 { font-size: 1.45rem; margin-top: auto; }
  .card-tag { color: var(--lime); font-weight: 500; }
  .card-go { color: var(--muted); margin-top: 0.5rem; }
  .card:hover .card-go { color: var(--lime); }

  .ai-sec { background: radial-gradient(60% 80% at 0% 50%, rgba(147, 0, 254, 0.16), transparent), var(--bg); }
  .checks { display: grid; gap: 0; border-top: 1px solid var(--line); }
  .checks li { padding: 1.1rem 0 1.1rem 2.25rem; border-bottom: 1px solid var(--line); position: relative; }
  .checks li::before { content: ''; position: absolute; left: 0; top: 1.35rem; width: 14px; height: 14px; border: 2px solid var(--lime); border-radius: 3px; background: linear-gradient(var(--lime), var(--lime)) center / 6px 6px no-repeat; }

  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
  .steps li { background: var(--bg); padding: 2rem 1.75rem; display: grid; gap: 0.75rem; align-content: start; }
  .step-n { color: var(--lime); font-size: 0.85rem; }
  .step-top { display: flex; justify-content: space-between; align-items: center; }
  .steps :global(.step-ic) { color: var(--lime); }
  .steps li { position: relative; }
  .steps li::before { content: ''; position: absolute; top: 0; left: 1.75rem; width: 32px; height: 3px; background: var(--lime); }
  .steps h3 { font-size: 1.6rem; }

  .stats { padding: 5rem 0; background: var(--green); color: var(--green-ink); }
  .stats-in { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; }
  .stat { font-family: 'Space Grotesk Variable', sans-serif; font-weight: 600; font-size: clamp(3rem, 6vw, 5rem); line-height: 1; letter-spacing: -0.04em; }
  .stat span { font-size: 0.5em; vertical-align: top; margin-left: 2px; }
  .stat span { color: inherit; }
  .stats .muted { color: rgba(11, 20, 2, 0.75); margin-top: 0.75rem; max-width: 16rem; font-weight: 500; }

  .ind { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1rem; }
  .ind a { position: relative; display: flex; flex-direction: column; height: 100%; border: 1px solid var(--line); border-radius: 14px; color: var(--text); overflow: hidden; background: var(--bg-2); transition: 0.2s; }
  .ind-img { aspect-ratio: 4 / 3; }
  .ind-body { display: grid; gap: 0.5rem; padding: 1.25rem 1.25rem 2.5rem; }
  .ind-ic { position: relative; z-index: 2; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; margin: -2.625rem 0 0.25rem; font-size: 1.3rem; color: var(--green-ink); background: var(--lime); box-shadow: 0 8px 20px -6px rgba(132, 189, 0, 0.6); }
  .ind a:hover .ind-img img { transform: scale(1.05); }
  .ind li:first-child .ind-img img { object-position: 12% 70%; }
  .ind a:hover { border-color: var(--lime); background: var(--bg-2); }
  .ind a > span { position: absolute; right: 1.25rem; bottom: 1.1rem; color: var(--lime); }

  .proof { display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem; }
  .quote { padding: 3rem; border: 1px solid var(--line); border-radius: 14px; background: var(--bg-2); }
  .quote blockquote { font-family: 'Space Grotesk Variable', sans-serif; font-size: clamp(1.6rem, 3vw, 2.4rem); line-height: 1.2; letter-spacing: -0.02em; }
  .quote figcaption { color: var(--muted); margin-top: 1.5rem; }
  .award :global(.award-ic) { color: #ff8500; margin-bottom: auto; }
  .award { padding: 2.25rem; border-radius: 14px; border: 1px solid rgba(255, 133, 0, 0.45); background: linear-gradient(160deg, rgba(255, 133, 0, 0.16), transparent); display: grid; align-content: end; gap: 0.5rem; }
  .award-t { font-family: 'Space Grotesk Variable', sans-serif; font-size: 1.6rem; line-height: 1.15; font-weight: 600; }

  .posts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .posts a { display: grid; gap: 1rem; padding: 1.5rem; border-top: 2px solid var(--line-2); color: var(--text); height: 100%; transition: border-color 0.2s; }
  .posts a:hover { border-color: var(--lime); }
  .posts h3 { font-size: 1.1rem; line-height: 1.3; }

  .cta { padding: 8rem 0; text-align: center; position: relative; overflow: hidden; }
  .cta::before { content: ''; position: absolute; inset: auto 0 -40%; height: 80%; background: radial-gradient(closest-side, rgba(132, 189, 0, 0.3), transparent); }
  .cta-in { position: relative; display: grid; justify-items: center; gap: 1.25rem; }
  .cta h2 { font-size: clamp(2.4rem, 5vw, 4rem); max-width: 18ch; }
  .cta p { font-size: 1.1rem; margin-bottom: 1rem; }

  .ftr { border-top: 1px solid var(--line); padding: 4rem 0 6rem; background: var(--bg-2); }
  .ftr-in { display: grid; grid-template-columns: 1.6fr repeat(4, 1fr); gap: 2rem; }
  .ftr-brand { display: grid; gap: 1rem; align-content: start; }
  .ftr ul { display: grid; gap: 0.55rem; margin-top: 1rem; }
  .ftr li a, .ftr-brand a { color: var(--text); font-size: 0.9rem; opacity: 0.8; }
  .ftr li a:hover { color: var(--lime); opacity: 1; }
  .ftr-legal { display: flex; justify-content: space-between; margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }

  /* Duotone photo treatment: every photo becomes purple-tinted monochrome so
     mixed sources read as one brand system. */
  .duo { position: relative; overflow: hidden; background: #172a00; margin: 0; }
  .duo img { display: block; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) sepia(1) hue-rotate(38deg) saturate(1.9) contrast(1.1) brightness(0.78); transition: transform 0.6s; }
  /* Purple duotone for the hero photo and the live-fire band. */
  .duo.duo-purple { background: #2a0b4d; }
  .duo.duo-purple img { filter: grayscale(1) sepia(1) hue-rotate(228deg) saturate(2.2) contrast(1.1) brightness(0.8); }
  .duo.duo-purple::after { background: linear-gradient(160deg, rgba(147, 0, 254, 0.35), transparent 55%), linear-gradient(0deg, rgba(7, 10, 8, 0.55), transparent 55%); }
  .duo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(160deg, rgba(132, 189, 0, 0.25), transparent 55%), linear-gradient(0deg, rgba(7, 10, 8, 0.55), transparent 55%); pointer-events: none; }

  .hero-in > * { min-width: 0; }
  .hero-vis { position: relative; }
  .hero-photo { position: absolute; top: -48px; right: -56px; width: 70%; aspect-ratio: 4 / 3; border-radius: 18px; border: 1px solid var(--line-2); }
  .hero-photo figcaption { position: absolute; z-index: 1; top: 14px; right: 14px; display: flex; align-items: center; gap: 6px; padding: 0.35rem 0.6rem; border-radius: 6px; background: rgba(7, 10, 8, 0.7); backdrop-filter: blur(6px); color: var(--text); font-size: 0.68rem; }
  .hero-photo figcaption b { width: 7px; height: 7px; border-radius: 50%; background: var(--lime); box-shadow: 0 0 8px var(--lime); }
  .hero-vis .console { position: relative; z-index: 1; margin: 140px 70px 0 -24px; }

  .floor { position: relative; min-height: 640px; display: grid; align-items: end; border-bottom: 1px solid var(--line); }
  .floor-img { position: absolute; inset: 0; }
  .floor-img.duo::after { background: linear-gradient(90deg, rgba(7, 10, 8, 0.92) 0%, rgba(7, 10, 8, 0.55) 45%, rgba(7, 10, 8, 0.1) 100%), linear-gradient(0deg, rgba(7, 10, 8, 0.9), transparent 45%); }
  .floor-in { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: end; padding: 9rem 0 4.5rem; }
  .floor-copy p:not(.eyebrow) { color: #d1d9d3; font-size: 1.12rem; margin-top: 1.25rem; max-width: 32rem; }
  .chips { display: grid; gap: 0.75rem; justify-items: end; }
  .chip { display: grid; gap: 0.2rem; min-width: 300px; max-width: 380px; padding: 0.85rem 1rem; border-radius: 12px; background: rgba(12, 16, 13, 0.8); backdrop-filter: blur(10px); border: 1px solid var(--line-2); border-left: 3px solid; font-size: 0.92rem; box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.6); }
  .chip .mono { font-size: 0.68rem; color: var(--muted); }
  .chip.red { border-left-color: var(--red); }
  .chip.purple { border-left-color: var(--purple-2); margin-right: 2.5rem; }
  .chip.green { border-left-color: var(--lime); margin-right: 5rem; }

  .card-vis { height: 120px; margin-bottom: 0.75rem; display: grid; align-items: center; }
  .mini-topo { width: 100%; height: 120px; }
  .mini-topo path { fill: none; stroke: rgba(255, 255, 255, 0.18); stroke-width: 1.5; }
  .mini-topo .n { fill: #161c17; stroke: rgba(255, 255, 255, 0.22); }
  .mini-topo .n.g { stroke: var(--lime); fill: rgba(154, 214, 42, 0.12); }
  .mini-topo .n.p { stroke: var(--purple-2); fill: rgba(147, 0, 254, 0.2); }
  .mini-topo text { fill: var(--muted); font: 600 10px 'JetBrains Mono Variable', monospace; text-anchor: middle; }
  .mini-chain { display: flex; flex-wrap: wrap; gap: 6px; align-content: center; }
  .mini-chain li { font: 500 0.72rem 'JetBrains Mono Variable', monospace; padding: 0.4rem 0.6rem; border-radius: 6px; border: 1px solid var(--line-2); color: var(--muted); }
  .mini-chain li.t-done { border-color: rgba(154, 214, 42, 0.5); color: var(--lime); background: rgba(154, 214, 42, 0.08); }
  .mini-chain li.t-live { border-color: var(--red); color: #ffd0d0; background: rgba(255, 93, 93, 0.14); animation: pulse 1.4s infinite; }
  .mini-vs { display: grid; gap: 0.9rem; }
  .mini-vs p { display: grid; grid-template-columns: 3.5rem 1fr 2rem; gap: 0.75rem; align-items: center; font-size: 0.82rem; color: var(--muted); }
  .mini-vs i { height: 8px; border-radius: 4px; background: linear-gradient(90deg, var(--c) var(--w), #1d241f var(--w)); }
  .mini-vs i.h { --c: var(--lime); }
  .mini-vs i.ai { --c: var(--purple-2); }
  .mini-vs b { color: var(--text); text-align: right; }
  .mini-grid { display: grid; grid-template-columns: repeat(14, 1fr); gap: 4px; }
  .mini-grid i { aspect-ratio: 1; border-radius: 3px; background: #1d241f; }
  .mini-grid i.on { background: rgba(154, 214, 42, 0.75); }
  .mini-grid i.now { background: var(--purple-2); box-shadow: 0 0 10px var(--purple-2); }
  .mini-decide { padding: 0.9rem 1rem; border-radius: 10px; background: #161c17; border: 1px solid var(--line-2); display: grid; gap: 0.35rem; }
  .mini-decide .mono { font-size: 0.66rem; color: var(--muted); }
  .mini-decide .q { font-weight: 600; }
  .mini-decide .opts { display: flex; flex-wrap: wrap; gap: 6px; }
  .mini-decide .opts span { font-size: 0.75rem; padding: 0.25rem 0.55rem; border-radius: 6px; border: 1px solid var(--line-2); color: var(--muted); }
  .mini-decide .opts .pick { border-color: var(--lime); color: var(--lime); }

  .ai-sec .checks { margin: 0 0 2rem; }
  .trace { background: linear-gradient(180deg, #141a15, #0b0f0c); border: 1px solid var(--line-2); border-radius: 16px; overflow: hidden; box-shadow: 0 0 80px -30px rgba(132, 189, 0, 0.35); }
  .trace-head { display: flex; justify-content: space-between; gap: 1rem; padding: 1rem 1.25rem; border-bottom: 1px solid var(--line); color: var(--muted); }
  .trace-head .mono { font-size: 0.7rem; }
  .legend { display: flex; gap: 1rem; }
  .legend span::before { content: ''; display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; }
