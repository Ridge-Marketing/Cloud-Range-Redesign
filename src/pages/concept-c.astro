---
// Concept C — "Live-Fire"
// Loud, high-contrast, brand-forward. Leans on the stencil wordmark and the
// brand purple + green to own a look nobody else in the category has.
// All motion is CSS-only.
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import {
  hero, nav, products, stats, steps, industries,
  customers, quote, award, posts, footer, contact,
} from '../data/site';

const ticker = [
  'T1566 Phishing', 'T1059 Command & Scripting', 'T1486 Data Encrypted for Impact',
  'T1021 Remote Services', 'T1003 OS Credential Dumping', 'T1190 Exploit Public-Facing App',
  'T0855 Unauthorized Command (ICS)', 'T1078 Valid Accounts', 'T1071 Application Layer Protocol',
];

// Range topology for the hero: nodes + the path the attack takes.
const nodes = [
  { id: 'inet', x: 40,  y: 160, label: 'Internet',  kind: 'red'   },
  { id: 'fw',   x: 150, y: 160, label: 'Firewall',  kind: 'base'  },
  { id: 'mail', x: 260, y: 70,  label: 'Mail',      kind: 'hit'   },
  { id: 'ws',   x: 260, y: 250, label: 'Endpoint',  kind: 'hit'   },
  { id: 'ad',   x: 380, y: 160, label: 'AD',        kind: 'hit'   },
  { id: 'siem', x: 500, y: 70,  label: 'SIEM',      kind: 'blue'  },
  { id: 'ot',   x: 500, y: 250, label: 'OT / ICS',  kind: 'base'  },
  { id: 'ai',   x: 600, y: 160, label: 'SOC Agent', kind: 'blue'  },
];
const links = [
  ['inet', 'fw'], ['fw', 'mail'], ['fw', 'ws'], ['mail', 'ad'], ['ws', 'ad'],
  ['ad', 'siem'], ['ad', 'ot'], ['siem', 'ai'], ['ot', 'ai'],
];
const attack = ['inet', 'fw', 'mail', 'ad', 'ot'];

const pos  = Object.fromEntries(nodes.map((n) => [n.id, n]));
const path = attack.map((id, i) => `${i ? 'L' : 'M'}${pos[id].x} ${pos[id].y}`).join(' ');
---
<Base title="Cloud Range — Concept C · Live-Fire">
  <div class="c">
    <header class="hdr">
      <div class="wrap hdr-in">
        <Logo tone="light" />
        <nav class="menu" aria-label="Primary">
          {nav.map((group) => (
            <div class="menu-item">
              <button type="button" aria-haspopup="true">{group.label}</button>
              <ul class="drop">{group.items.map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul>
            </div>
          ))}
        </nav>
        <a href="#demo" class="btn">Get a demo <span aria-hidden="true">↗</span></a>
        <details class="mnav">
          <summary aria-label="Open menu">≡</summary>
          <div class="mnav-panel">
            {nav.map((g) => (
              <div>
                <p class="k">{g.label}</p>
                <ul>{g.items.map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul>
              </div>
            ))}
            <a href="#demo" class="btn">Get a demo</a>
          </div>
        </details>
      </div>
    </header>

    <main>
      <!-- HERO -->
      <section class="hero">
        <div class="wrap">
          <p class="k hero-k"><span class="rec"></span> Live-fire cyber range · Humans + AI</p>
          <h1>
            <span>Readiness is</span>
            <span class="stencil">proven<i>.</i></span>
            <span class="out">Not assumed.</span>
          </h1>
          <div class="hero-row">
            <p class="lede">{hero.body}</p>
            <div class="ctas">
              <a href="#demo" class="btn btn-xl">Request a demo <span aria-hidden="true">↗</span></a>
              <a href="#platform" class="btn btn-ghost btn-xl">Explore the platform</a>
            </div>
          </div>
        </div>

        <div class="wrap">
          <figure class="topo" aria-label="Diagram of a live-fire attack moving through a replica enterprise network toward OT systems, watched by the SIEM and a SOC agent">
            <div class="topo-scroll"><svg viewBox="0 0 640 320" role="img">
              <defs>
                <pattern id="dots" width="16" height="16" patternUnits="userSpaceOnUse">
                  <circle cx="1" cy="1" r="1" fill="rgba(255,255,255,0.08)" />
                </pattern>
              </defs>
              <rect width="640" height="320" fill="url(#dots)" />
              {links.map(([a, b]) => (
                <line x1={pos[a].x} y1={pos[a].y} x2={pos[b].x} y2={pos[b].y} class="ln" />
              ))}
              <path d={path} class="atk" />
              {nodes.map((n) => (
                <g class:list={['nd', n.kind]} transform={`translate(${n.x} ${n.y})`}>
                  <rect x="-18" y="-18" width="36" height="36" rx="6" />
                  <text y="34">{n.label}</text>
                </g>
              ))}
            </svg></div>
            <figcaption>
              <span><b class="sw red"></b>Adversary</span>
              <span><b class="sw hit"></b>Compromised</span>
              <span><b class="sw blue"></b>Defenders · human &amp; AI</span>
              <span class="k">Exercise 0417 · OT ransomware</span>
            </figcaption>
          </figure>
        </div>
      </section>

      <!-- TICKER -->
      <div class="ticker" aria-hidden="true">
        <div class="ticker-track">
          {[...ticker, ...ticker].map((t) => <span>{t}<b>✕</b></span>)}
        </div>
      </div>

      <!-- STATS -->
      <section class="stats">
        <div class="wrap stats-in">
          {stats.map((s) => (
            <div>
              <p class="stat">{s.value}<span>{s.unit}</span></p>
              <p>{s.label}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- PLATFORM -->
      <section class="sec" id="platform">
        <div class="wrap">
          <div class="sec-head">
            <p class="k">[ 01 ] Platform</p>
            <h2>Train like it's <span class="hl">real</span>. Because it is.</h2>
          </div>
          <div class="prods">
            {products.map((p, i) => (
              <a href="#" class="prod">
                <span class="prod-n">0{i + 1}</span>
                <div>
                  <h3>{p.name}</h3>
                  <p>{p.body}</p>
                </div>
                <span class="prod-tag k">{p.tagline}</span>
                <span class="prod-go" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- AI BAND -->
      <section class="ai" id="ai">
        <div class="wrap ai-in">
          <div>
            <p class="k">[ 02 ] AI Validation Range™</p>
            <h2>Would you let an untested analyst run your SOC?</h2>
          </div>
          <div>
            <p>Then don't let an untested agent do it either. Cloud Range runs AI agents through the same live-fire scenarios as your team and scores every decision — so you know exactly what it'll do when the attack is real.</p>
            <a href="#demo" class="btn btn-dark btn-xl">Validate your AI <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>

      <!-- HOW -->
      <section class="sec" id="how">
        <div class="wrap">
          <div class="sec-head">
            <p class="k">[ 03 ] How it works</p>
            <h2>Replicate. Attack. Measure. Prove.</h2>
          </div>
          <ol class="steps">
            {steps.map((s) => (
              <li>
                <span class="step-n stencil">{s.n}</span>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- LOGOS + QUOTE -->
      <section class="sec proof">
        <div class="wrap">
          <figure class="q">
            <blockquote>“{quote.text}”</blockquote>
            <figcaption class="k">— {quote.source}</figcaption>
          </figure>
          <div class="award">
            <span class="award-badge stencil">2026</span>
            <div>
              <p class="award-t">{award.title}</p>
              <p class="k">{award.body}</p>
            </div>
          </div>
          <ul class="logos">{customers.map((c) => <li>{c}</li>)}</ul>
        </div>
      </section>

      <!-- INDUSTRIES -->
      <section class="sec" id="industries">
        <div class="wrap">
          <div class="sec-head">
            <p class="k">[ 04 ] Industries</p>
            <h2>Every sector has a worst day. Rehearse yours.</h2>
          </div>
          <ul class="ind">
            {industries.map((i) => (
              <li><a href="#"><h3>{i.name}</h3><p>{i.body}</p></a></li>
            ))}
          </ul>
        </div>
      </section>

      <!-- RESOURCES -->
      <section class="sec" id="resources">
        <div class="wrap">
          <div class="sec-head row">
            <div>
              <p class="k">[ 05 ] Field notes</p>
              <h2>From the range</h2>
            </div>
            <a href="#" class="btn btn-ghost">All posts</a>
          </div>
          <ul class="posts">
            {posts.map((p) => (
              <li>
                <a href="#">
                  <span class="k">{p.date} · {p.tag}</span>
                  <h3>{p.title}</h3>
                  <span class="prod-go" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- CTA -->
      <section class="cta" id="demo">
        <div class="wrap">
          <h2 class="stencil">Ready?<br />Prove it.</h2>
          <div class="cta-row">
            <p>Feel confident about your cyber defense. See a live-fire exercise built around your environment.</p>
            <a href="#" class="btn btn-dark btn-xl">Request a demo <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>
    </main>

    <footer class="ftr">
      <div class="wrap ftr-in">
        <div class="ftr-brand">
          <Logo tone="light" />
          <p><a href={`mailto:${contact.email}`}>{contact.email}</a><br />{contact.phone}</p>
        </div>
        {footer.map((col) => (
          <div>
            <p class="k">{col.title}</p>
            <ul>{col.links.map((l) => <li><a href="#">{l}</a></li>)}</ul>
          </div>
        ))}
      </div>
      <div class="wrap ftr-legal k">
        <span>© 2026 Cloud Range</span>
        <a href="#">Privacy</a>
      </div>
    </footer>
  </div>
</Base>

<style>
  .c {
    --bg:     #000;
    --bg-2:   #0d0b11;
    --ink:    #f5f2f8;
    --muted:  #958e9e;
    --line:   rgba(255, 255, 255, 0.12);
    --lime:   #a3e000;
    --purp:   #9300fe;
    --purp-t: #c08bff;
    --red:    #ff4d3d;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Inter Variable', system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.55;
    overflow-x: clip;
  }
  .wrap { width: min(1320px, 100% - 32px); margin-inline: auto; }
  .k { font-family: 'JetBrains Mono Variable', ui-monospace, monospace; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  .stencil { font-family: 'Saira Stencil One', 'Inter Variable', sans-serif; font-weight: 400; letter-spacing: 0; }
  h1, h2, h3 { font-weight: 800; letter-spacing: -0.04em; line-height: 0.95; text-transform: uppercase; }
  h2 { font-size: clamp(2.4rem, 6vw, 5rem); }
  h3 { font-size: 1.5rem; letter-spacing: -0.02em; line-height: 1.05; }
  a { text-decoration: none; }
  .hl { color: var(--lime); }

  .btn { display: inline-flex; align-items: center; gap: 0.5rem; background: var(--purp); color: #fff; font-weight: 700; font-size: 0.9rem; padding: 0.7rem 1.1rem; text-transform: uppercase; letter-spacing: 0.02em; clip-path: polygon(0 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%); transition: background 0.2s, transform 0.2s; white-space: nowrap; }
  .btn:hover { background: var(--lime); color: #000; }
  .btn-xl { padding: 1.1rem 1.6rem; font-size: 1rem; }
  .btn-ghost { background: transparent; color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--line); clip-path: none; }
  .btn-ghost:hover { background: transparent; box-shadow: inset 0 0 0 1.5px var(--purp-t); color: var(--purp-t); }
  .btn-dark { background: #000; color: var(--lime); }
  .btn-dark:hover { background: #1a1a1a; color: #fff; }

  .hdr { position: sticky; top: 0; z-index: 50; background: rgba(0, 0, 0, 0.82); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .hdr-in { display: flex; align-items: center; gap: 2rem; height: 64px; }
  .menu { display: flex; margin-left: auto; }
  .menu-item { position: relative; }
  .menu-item > button { background: none; border: 0; color: var(--ink); padding: 0.5rem 0.9rem; font: 600 0.78rem 'JetBrains Mono Variable', monospace; text-transform: uppercase; letter-spacing: 0.08em; cursor: pointer; }
  .menu-item:hover > button, .menu-item:focus-within > button { color: var(--purp-t); }
  .drop { position: absolute; top: 100%; left: 0; min-width: 260px; background: var(--purp); padding: 0.75rem; opacity: 0; visibility: hidden; transform: translateY(8px); transition: 0.15s; }
  .menu-item:hover .drop, .menu-item:focus-within .drop { opacity: 1; visibility: visible; transform: translateY(12px); }
  .drop::before { content: ''; position: absolute; inset: -14px 0 auto; height: 14px; }
  .drop a { display: block; color: #fff; font-weight: 600; padding: 0.45rem 0.5rem; }
  .drop a:hover { background: #000; color: var(--lime); }
  .mnav { display: none; }

  .hero { padding: 4rem 0 0; position: relative; }
  .hero::before { content: ''; position: absolute; inset: 0; background: radial-gradient(50% 50% at 80% 10%, rgba(147, 0, 254, 0.35), transparent); pointer-events: none; }
  .hero > .wrap { position: relative; z-index: 1; }
  .hero-k { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 2rem; color: var(--ink); }
  .rec { width: 9px; height: 9px; border-radius: 50%; background: var(--red); box-shadow: 0 0 12px var(--red); animation: blink 1.2s steps(2) infinite; }
  @keyframes blink { 50% { opacity: 0.2; } }
  h1 { font-size: clamp(3.2rem, 11vw, 10.5rem); display: grid; }
  h1 .stencil { color: var(--lime); font-size: 1.08em; line-height: 0.95; }
  h1 .stencil i { color: var(--ink); font-style: normal; }
  /* Outline text: the fill is painted over a double-width stroke, which hides the
     variable font's overlapping contours and leaves a clean outer outline. */
  h1 .out { color: var(--bg); -webkit-text-stroke: 4px rgba(255, 255, 255, 0.6); paint-order: stroke fill; }
  @supports not (-webkit-text-stroke: 1px #fff) { h1 .out { color: #5f6762; } }
  .hero-row { display: grid; grid-template-columns: 1fr auto; gap: 3rem; align-items: end; margin-top: 2.75rem; padding-bottom: 3rem; }
  .lede { font-size: 1.15rem; color: #c3cac5; max-width: 38rem; }
  .ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  .topo { border: 1px solid var(--line); background: var(--bg-2); margin-bottom: -1px; }
  .topo-scroll { overflow-x: auto; }
  .topo svg { width: 100%; min-width: 600px; height: auto; max-height: 420px; }
  .ln { stroke: rgba(255, 255, 255, 0.16); stroke-width: 1.5; }
  .atk { fill: none; stroke: var(--red); stroke-width: 2.5; stroke-dasharray: 8 6; animation: march 1s linear infinite; filter: drop-shadow(0 0 6px rgba(255, 77, 61, 0.6)); }
  @keyframes march { to { stroke-dashoffset: -14; } }
  .nd rect { fill: #111311; stroke: rgba(255, 255, 255, 0.3); stroke-width: 1.5; }
  .nd text { fill: var(--muted); font: 600 10px 'JetBrains Mono Variable', monospace; text-anchor: middle; text-transform: uppercase; letter-spacing: 0.06em; }
  .nd.red rect { fill: var(--red); stroke: var(--red); }
  .nd.hit rect { stroke: var(--red); fill: #2a1311; }
  .nd.blue rect { stroke: var(--lime); fill: #1b2508; }
  .nd.blue text { fill: var(--lime); }
  .topo figcaption { display: flex; flex-wrap: wrap; gap: 0.75rem 1.75rem; padding: 1rem 1.25rem; border-top: 1px solid var(--line); font-size: 0.85rem; color: #c3cac5; align-items: center; }
  .topo figcaption .k { margin-left: auto; }
  .sw { display: inline-block; width: 10px; height: 10px; margin-right: 0.45rem; vertical-align: -1px; }
  .sw.red { background: var(--red); }
  .sw.hit { border: 1.5px solid var(--red); }
  .sw.blue { background: var(--lime); }

  .ticker { background: var(--purp); color: #fff; overflow: hidden; padding: 0.9rem 0; }
  .ticker-track { display: flex; width: max-content; animation: scroll 40s linear infinite; }
  .ticker span { font: 700 0.9rem 'JetBrains Mono Variable', monospace; text-transform: uppercase; white-space: nowrap; padding-right: 1.5rem; }
  .ticker b { margin-left: 1.5rem; color: var(--lime); }
  @keyframes scroll { to { transform: translateX(-50%); } }

  .stats { border-bottom: 1px solid var(--line); }
  .stats-in { display: grid; grid-template-columns: repeat(4, 1fr); }
  .stats-in > div { padding: 3.5rem 1.5rem 3rem; border-left: 1px solid var(--line); }
  .stats-in > div:last-child { border-right: 1px solid var(--line); }
  .stat { font-family: 'Saira Stencil One', sans-serif; font-size: clamp(3.5rem, 7vw, 6.5rem); line-height: 1; color: var(--lime); }
  .stat span { font-size: 0.5em; vertical-align: top; color: var(--ink); }
  .stats-in p:last-child { color: var(--muted); margin-top: 0.75rem; max-width: 15rem; }

  .sec { padding: 7rem 0; border-bottom: 1px solid var(--line); }
  .sec-head { margin-bottom: 3.5rem; display: grid; gap: 1.25rem; max-width: 60rem; }
  .sec-head.row { max-width: none; display: flex; justify-content: space-between; align-items: end; }
  .sec-head .k { color: var(--purp-t); }

  .prods { border-top: 1px solid var(--line); }
  .prod { display: grid; grid-template-columns: 5rem 1.6fr 1fr 2.5rem; gap: 2rem; align-items: center; padding: 2rem 0; border-bottom: 1px solid var(--line); color: var(--ink); position: relative; transition: padding 0.25s, color 0.25s; }
  .prod::before { content: ''; position: absolute; inset: 0; background: var(--purp); transform: scaleY(0); transform-origin: bottom; transition: transform 0.25s; z-index: 0; }
  .prod > * { position: relative; z-index: 1; }
  .prod:hover { color: #fff; padding-inline: 1.5rem; }
  .prod:hover::before { transform: scaleY(1); }
  .prod:hover p, .prod:hover .k { color: rgba(255, 255, 255, 0.88); }
  .prod-n { font-family: 'Saira Stencil One', sans-serif; font-size: 2.4rem; color: var(--lime); }
  .prod:hover .prod-n { color: var(--lime); }
  .prod h3 { font-size: clamp(1.6rem, 3vw, 2.4rem); margin-bottom: 0.5rem; }
  .prod p { color: var(--muted); max-width: 36rem; }
  .prod-go { font-size: 1.6rem; justify-self: end; }

  .ai { background: var(--purp); color: #fff; padding: 7rem 0; background-image: radial-gradient(60% 100% at 100% 100%, rgba(255, 133, 0, 0.35), transparent 60%); }
  .ai-in { display: grid; grid-template-columns: 1.2fr 1fr; gap: 4rem; align-items: end; }
  .ai .k { color: #fff; margin-bottom: 1.25rem; }
  .ai h2 { font-size: clamp(2.4rem, 5.4vw, 4.6rem); }
  .ai p:not(.k) { font-size: 1.2rem; font-weight: 500; margin-bottom: 2rem; }

  .steps { display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--line); }
  .steps li { padding: 2rem; display: grid; gap: 1rem; align-content: start; }
  .steps li + li { border-left: 1px solid var(--line); }
  .step-n { font-size: 4.5rem; line-height: 1; color: transparent; -webkit-text-stroke: 1.5px var(--lime); }
  .steps h3 { font-size: 2rem; }
  .steps p { color: var(--muted); }

  .proof .wrap { display: grid; grid-template-columns: 1.6fr 1fr; gap: 3rem; align-items: center; }
  .q blockquote { font-size: clamp(2rem, 4.5vw, 4rem); font-weight: 800; letter-spacing: -0.04em; line-height: 1; text-transform: uppercase; }
  .q figcaption { margin-top: 1.5rem; color: var(--purp-t); }
  .award { display: flex; gap: 1.5rem; align-items: center; padding: 2rem; border: 1px solid var(--purp); }
  .award-badge { background: var(--purp); color: #fff; font-size: 1.6rem; padding: 0.8rem 0.9rem; flex-shrink: 0; }
  .award-t { font-size: 1.35rem; font-weight: 800; text-transform: uppercase; letter-spacing: -0.02em; line-height: 1.05; margin-bottom: 0.5rem; }
  .logos { grid-column: 1 / -1; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem 2.5rem; padding-top: 3rem; border-top: 1px solid var(--line); }
  .logos li { font-weight: 800; font-size: 1.2rem; color: #5d645f; text-transform: uppercase; letter-spacing: -0.02em; }

  .ind { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .ind a { display: grid; gap: 1rem; align-content: space-between; min-height: 260px; padding: 1.75rem; background: var(--bg); color: var(--ink); transition: background 0.2s; }
  .ind a:hover { background: var(--bg-2); }
  .ind a:hover h3 { color: var(--purp-t); }
  .ind p { color: var(--muted); font-size: 0.92rem; }

  .posts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .posts a { position: relative; display: grid; gap: 2.5rem; align-content: space-between; min-height: 240px; padding: 1.5rem; background: var(--bg-2); border: 1px solid var(--line); color: var(--ink); transition: border-color 0.2s; }
  .posts a:hover { border-color: var(--purp); }
  .posts h3 { font-size: 1.25rem; text-transform: none; letter-spacing: -0.02em; line-height: 1.2; font-weight: 700; }
  .posts .prod-go { position: absolute; top: 1.1rem; right: 1.25rem; font-size: 1.2rem; color: var(--purp-t); }

  .cta { background: var(--purp); color: #fff; padding: 6rem 0 5rem; }
  .cta h2 { font-size: clamp(4rem, 15vw, 13rem); line-height: 0.85; }
  .cta-row { display: flex; justify-content: space-between; align-items: end; gap: 2rem; flex-wrap: wrap; margin-top: 3rem; padding-top: 2rem; border-top: 2px solid rgba(255, 255, 255, 0.6); }
  .cta-row p { font-size: 1.25rem; font-weight: 500; max-width: 32rem; }

  .ftr { padding: 4rem 0 6rem; }
  .ftr-in { display: grid; grid-template-columns: 1.6fr repeat(4, 1fr); gap: 2rem; }
