---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/saira-stencil-one';
import '../styles/reset.css';
import ConceptBar from '../components/ConceptBar.astro';

interface Props {
  title:        string;
  description?: string;
  showBar?:     boolean;
}

const {
  title,
  description = 'Cloud Range validates the cyber readiness of human teams and AI agents with live-fire attack simulations and measurable reporting.',
  showBar     = true,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <slot />
    {showBar && <ConceptBar />}
  </body>
</html>
