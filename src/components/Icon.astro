---
// Inline Font Awesome Sharp Solid icon. Decorative by default; pass `label`
// when the icon carries meaning on its own.
import { icons, type IconName } from '../data/icons';

interface Props {
  name:   IconName;
  size?:  number | string;
  label?: string;
  class?: string;
}

const { name, size = '1em', label, class: className } = Astro.props;
const icon  = icons[name];
const paths = Array.isArray(icon.d) ? icon.d : [icon.d];
---
<svg
  class:list={['icon', className]}
  viewBox={`0 0 ${icon.w} ${icon.h}`}
  width={size}
  height={size}
  fill="currentColor"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>{paths.map((d) => <path d={d} />)}</svg>

<style>
  .icon { display: inline-block; flex-shrink: 0; vertical-align: -0.125em; }
</style>
