---
// Floating switcher for review sessions only — not part of any design.
const concepts = [
  { href: '/concept-a', label: 'A · Command' },
  { href: '/concept-b', label: 'B · Exercise' },
  { href: '/concept-c', label: 'C · Live-Fire' },
];

const current = Astro.url.pathname.replace(/\/$/, '');
---
<nav class="concept-bar" aria-label="Design concepts">
  <a href="/" class="all">All concepts</a>
  {concepts.map((c) => (
    <a href={c.href} aria-current={current === c.href ? 'page' : undefined}>{c.label}</a>
  ))}
</nav>

<style>
  .concept-bar {
    position: fixed;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 100;
    display: flex;
    gap: 2px;
    padding: 4px;
    background: rgba(14, 11, 20, 0.9);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    font: 500 12px/1 'Inter Variable', system-ui, sans-serif;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    max-width: calc(100vw - 32px);
    overflow-x: auto;
  }
  a {
    color: #c9cfcb;
    text-decoration: none;
    padding: 9px 14px;
    border-radius: 999px;
    white-space: nowrap;
  }
  a:hover { color: #fff; }
  a[aria-current='page'] { background: #9300fe; color: #fff; }
  .all { color: #8a918d; }
</style>
