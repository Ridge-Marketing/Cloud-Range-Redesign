---
// Official Cloud Range logo, keyed off the color JPG on the live site into
// transparent dark-text and light-text PNGs. Swap for the brand SVG when we have it.
interface Props {
  tone?:   'dark' | 'light';
  height?: number;
  class?:  string;
}

const { tone = 'dark', height = 30, class: className } = Astro.props;
const width = Math.round(height * (720 / 129));
---
<a href="/" class:list={['logo', className]} aria-label="Cloud Range home">
  <img src={`/brand/logo-${tone}.png`} alt="Cloud Range" width={width} height={height} />
</a>

<style>
  .logo { display: inline-flex; flex-shrink: 0; }
  img { display: block; height: auto; max-width: 100%; }
</style>
